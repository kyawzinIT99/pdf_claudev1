# One-time owner bootstrap. Set these as protected runtime secrets, sign in once,
# then create Administrator and Editor accounts from Team Access.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Exact public HTTPS origin used for browser CSRF validation.
APP_ORIGIN=https://example.org

# MySQL. Create these in hosting and store the values only in protected env settings.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional machine-to-machine key for approved automation.
ADMIN_WRITE_TOKEN=

# PDF n8n workflows on the existing Hostinger instance (not BCC webhook paths).
# 1 Inquiry alert — /webhook/pdf-inquiry-alert
N8N_INQUIRY_ALERT_WEBHOOK=
# 2 Publish distribution — /webhook/pdf-publish-distribution
N8N_PUBLISH_WEBHOOK=
# 3 Subscribe alert — /webhook/pdf-subscribe-alert
N8N_SUBSCRIBE_ALERT_WEBHOOK=
# 4 Event mail — /webhook/pdf-event-mail
N8N_EVENT_MAIL_WEBHOOK=
# 5 n8n API / stats
N8N_BASE_URL=
N8N_API_KEY=
# 6 Shared webhook secret (inquiry + /api/n8n/stats)
N8N_INQUIRY_WEBHOOK_SECRET=
# 7 CRM routing (Telegram + staff email, delivered by the inquiry/subscribe workflows)
CRM_ALERTS_ENABLED=false
CRM_ALERT_EMAIL=
CRM_TELEGRAM_CHAT_ID=
# Public mailbox shown on Get Involved (visitor greeting + mailto)
PUBLIC_CONTACT_EMAIL=pdfantimailtary@gmail.com

# Private Admin assistant. Keep the key server-side and disabled until reviewed.
MR_KYAW_ZIN_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_VECTOR_STORE_ID=
